# Fill these from the commissioned map and two independent safety inputs.
CLEANY_MISSION_GRID_REVISION=
CLEANY_ESTOP_RELEASED_TOPIC=
CLEANY_PROTECTION_READY_TOPIC=

CLEANY_FIELD_INSTALL=/opt/cleany/current/field/install
CLEANY_FIELD_REPO=/opt/cleany/current/field/repo
CLEANY_BUILD_ROOT=/opt/cleany/current/field
CLEANY_HARDWARE_DEPS_ROOT=/opt/cleany/current/field/deps
CLEANY_BASE_PROFILE=/etc/opt/cleany/field/profiles/mapping_cad_lidar_front.yaml
CLEANY_ROBOT_STATE_PROFILE=/etc/opt/cleany/native/configs/robot/cad_grasp.json
CLEANY_FEETECH_CONTROL_CONFIG=/etc/opt/cleany/field/feetech_control.yaml
CLEANY_HARDWARE_MONITOR_CONFIG=/etc/opt/cleany/field/hardware_motion_monitor.yaml
CLEANY_FIELD_CONFIG_DIR=/etc/opt/cleany/field
XDG_STATE_HOME=/var/opt/cleany/state
CLEANY_FIELD_STATE_DIR=/var/opt/cleany/state/cleany
CLEANY_FIELD_MAP=/var/opt/cleany/robot/map/source.yaml
CLEANY_DEVICE_TOKEN_FILE=/etc/opt/cleany/control-plane/cleany-01.token
CLEANY_FIELD_DDS_FILE=/etc/opt/cleany/field/fastdds.xml
CLEANY_FIELD_RMW=rmw_fastrtps_cpp
CLEANY_SCENE_RUNTIME_PREFIX=/opt/cleany/current/field/deps/moveit-scene-runtime
CLEANY_MOVEIT_PATCH_PREFIX=/opt/cleany/current/field/deps/moveit-octomap-lock
CLEANY_SCENE_DEPENDENCY_PREFIX=/opt/cleany/current/field/deps/moveit-perception
CLEANY_COLLECTION_RUN_ROOT=/var/opt/cleany/runs/manipulation
CLEANY_DATABASE_PATH=/var/opt/cleany/control-plane/control-plane.db
CLEANY_FIELD_NAVIGATION_RUNS=/var/opt/cleany/runs/navigation/integration
CLEANY_YOLOE_NATIVE_VENV=/opt/cleany/current/native/yolo-env
YOLOE_MODEL_HOST_DIR=/var/opt/cleany/models/yoloe
