# Source from Bash to select the commissioned Cleany Jetson profiles.
# Launchers use --connected to select them only for the matching arm bus.
if [[ "${1:-}" == --connected ]]; then
  if [[ ! -c /dev/serial/by-id/usb-1a86_USB_Single_Serial_5B14111971-if00 ||
        -v CLEANY_MANIPULATION_COLLECTION_CONFIG || -v CLEANY_FEETECH_CONTROL_CONFIG ||
        -v CLEANY_HARDWARE_MONITOR_CONFIG ]]; then
    return 0
  fi
fi

jetson_profile_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
export CLEANY_MANIPULATION_COLLECTION_CONFIG="${CLEANY_MANIPULATION_COLLECTION_CONFIG-${jetson_profile_dir}/collection.json}"
export CLEANY_FEETECH_CONTROL_CONFIG="${CLEANY_FEETECH_CONTROL_CONFIG-${jetson_profile_dir}/feetech_control.yaml}"
export CLEANY_HARDWARE_MONITOR_CONFIG="${CLEANY_HARDWARE_MONITOR_CONFIG-${jetson_profile_dir}/hardware_motion_monitor.yaml}"
export CLEANY_ROBOT_STATE_PROFILE="${CLEANY_ROBOT_STATE_PROFILE-${jetson_profile_dir%/*}/cad_grasp.json}"
export CLEANY_COLLECTION_MOTION_BACKEND="${CLEANY_COLLECTION_MOTION_BACKEND-curobo_ik_moveit}"
export CLEANY_COLLECTION_GRASP_PREDICTOR="${CLEANY_COLLECTION_GRASP_PREDICTOR-geometric}"
export CLEANY_COLLECTION_USE_EXISTING_PERCEPTION="${CLEANY_COLLECTION_USE_EXISTING_PERCEPTION-true}"
export CLEANY_COLLECTION_SHARED_RMW_IMPLEMENTATION="${CLEANY_COLLECTION_SHARED_RMW_IMPLEMENTATION-rmw_fastrtps_cpp}"
unset jetson_profile_dir
