<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config">
  <Domain Id="any">
    <General>
      <Interfaces>
        <NetworkInterface name="eth0" multicast="false" />
      </Interfaces>
      <AllowMulticast>false</AllowMulticast>
      <!-- Keep UDP payloads within the 1500-byte IPv4 bridge MTU. -->
      <MaxMessageSize>1456B</MaxMessageSize>
    </General>
    <Internal>
      <!-- RGB-D bursts need headroom; raise the host net.core.rmem_max as documented. -->
      <SocketReceiveBufferSize min="default" max="8MiB" />
    </Internal>
    <Discovery>
      <ParticipantIndex>auto</ParticipantIndex>
      <!-- Native simulation + MoveIt + model services exceed the default index pool. -->
      <MaxAutoParticipantIndex>64</MaxAutoParticipantIndex>
      <Peers>
        <Peer Address="172.30.0.1" />
      </Peers>
    </Discovery>
  </Domain>
</CycloneDDS>
