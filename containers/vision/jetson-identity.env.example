# /etc/cleany/jetson-identity.env에 소유자 root:root, 권한 0644로 설치합니다.
# 자리표시자입니다. MAC, feature ID와 라이선스 파일을 Jetson의 라이선스에
# 등록된 값으로 교체하며 실제 값은 커밋하지 않습니다.
ANYGRASP_MAC_ADDRESS=02:00:00:00:00:01
ANYGRASP_IPV4_ADDRESS=172.30.0.10
ANYGRASP_EXPECTED_FEATURE_ID=N00000000000000000000
PERCEPTION_IPV4_ADDRESS=172.30.0.11
VLM_IPV4_ADDRESS=172.30.0.12
MOTION_IPV4_ADDRESS=172.30.0.13
HYBRID_SUBNET=172.30.0.0/24
HYBRID_GATEWAY=172.30.0.1

ROS_DOMAIN_ID=0

ANYGRASP_LICENSE_HOST_DIR=/home/cleany/.local/share/cleany/anygrasp/license
ANYGRASP_LICENSE_FILE=anygrasp.lic
ANYGRASP_MODEL_HOST_DIR=/home/cleany/models/anygrasp
ANYGRASP_CHECKPOINT_PATH=/models/anygrasp/checkpoint_detection.tar

YOLOE_MODEL_HOST_DIR=/home/cleany/models/yoloe
