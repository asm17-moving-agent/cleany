#!/usr/bin/env bash
set -euo pipefail

set +u
source "/opt/ros/${ROS_DISTRO:-humble}/setup.bash"
set -u
cd /workspace/cleany/ros2_ws

role="${CLEANY_WORKSPACE_ROLE:?CLEANY_WORKSPACE_ROLE is required}"
case "${role}" in
  anygrasp) packages=(cleany_grasping) ;;
  perception) packages=(cleany_perception) ;;
  *) echo "Unsupported workspace role: ${role}" >&2; exit 1 ;;
esac

colcon --log-base "log-${role}" build \
  --symlink-install \
  --build-base "build-${role}" \
  --install-base "install-${role}" \
  --packages-up-to "${packages[@]}"
