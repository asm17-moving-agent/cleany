#!/usr/bin/env bash
set -euo pipefail

/opt/cleany/bin/build-workspace
set +u
source /workspace/cleany/ros2_ws/install-vision/setup.bash
set -u

license_path="${ANYGRASP_LICENSE_DIR}/${ANYGRASP_LICENSE_FILE}"

ros2 launch cleany_perception inspect_scene.launch.py \
  sam2_model_config:="${SAM2_MODEL_CONFIG}" \
  sam2_checkpoint:="${SAM2_CHECKPOINT_PATH}" \
  sam2_device:=cuda &
perception_pid=$!

ros2 run cleany_grasping grasp_server --ros-args \
  --params-file /workspace/cleany/ros2_ws/src/cleany_grasping/config/anygrasp.yaml \
  -p checkpoint_path:="${ANYGRASP_CHECKPOINT_PATH}" \
  -p license_path:="${license_path}" &
grasping_pid=$!

cleanup() {
  kill "${perception_pid}" "${grasping_pid}" 2>/dev/null || true
  wait "${perception_pid}" "${grasping_pid}" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

wait -n "${perception_pid}" "${grasping_pid}"
