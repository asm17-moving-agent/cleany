(version 1)
# SPDX-License-Identifier: MIT
# Hansaem Digitec FR-4, 2 layers, nominal 1.6T, base copper 1 oz; ordinary through-hole process.
# Adapted from Cimos/kicad-druid v1.2.0, commit
# 8af046d6a1839320a360a4b6790ac11eb27a78ae, JLCPCB/JLCPCB-2L-1oz.kicad_dru.
# License: libraries/LICENSE.kicad-druid.md
# Capability source: https://www.hsdgt.com/order/information.html
# Checked 2026-11-11. Legacy project margins are identified below.
# Profile, local corrections and validation: DESIGN_RULES.md
#
# Specific rules follow general ones: KiCad resolves the last matching constraint.
# Cost warnings use assertions, never annular-width or drill-size overrides.

(rule "Hansaem 2L 1oz: Mechanical drill"
    (constraint hole_size (min 0.2mm) (max 6mm))
)

(rule "Project: NPTH drill"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
    (constraint hole_size (min 0.5mm))
)

(rule "Hansaem 2L 1oz: Castellated drill"
    (condition "A.Type == 'Pad' && A.Fabrication_Property == 'Castellated pad'")
    (constraint hole_size (min 0.6mm))
)

(rule "Hansaem 2L 1oz: Via diameter"
    (condition "A.Type == 'Via'")
    (constraint via_diameter (min 0.5mm))
)

(rule "Hansaem 2L 1oz: Via annular ring"
    (condition "A.Type == 'Via'")
    (constraint annular_width (min 0.15mm))
)

(rule "Hansaem 2L 1oz: PTH annular ring"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated()")
    (constraint annular_width (min 0.2mm))
)

# Hole-only NPTH locating pegs do not require a copper annulus.
(rule "Project: SMD copper pad"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'SMD' && (A.existsOnLayer('F.Cu') || A.existsOnLayer('B.Cu'))")
    (constraint assertion "A.Size_X >= 0.25mm && A.Size_Y >= 0.25mm")
)

(rule "Hansaem 2L 1oz: Through vias only"
    (condition "A.Type == 'Via'")
    (constraint assertion "!(A.isBlindBuriedVia() || A.isMicroVia())")
)

(rule "Hansaem 2L 1oz: Small via surcharge"
    (condition "A.Type == 'Via'")
    (severity warning)
    (constraint assertion "A.Hole >= 0.3mm")
)

(rule "Hansaem 2L 1oz: Plated slot width"
    (condition "A.Type == 'Pad' && A.Hole_Size_X != A.Hole_Size_Y && A.isPlated()")
    (constraint hole_size (min 0.5mm))
)

(rule "Project: Plated slot aspect ratio"
    (condition "A.Type == 'Pad' && A.isPlated() && A.Hole_Size_X != A.Hole_Size_Y")
    (constraint assertion "A.Hole_Size_X >= 2 * A.Hole_Size_Y || A.Hole_Size_Y >= 2 * A.Hole_Size_X")
)

(rule "Project: NPTH slot width"
    (condition "A.Type == 'Pad' && A.Hole_Size_X != A.Hole_Size_Y && !A.isPlated()")
    (constraint hole_size (min 1mm))
)

# Drill-bit protection is independent of electrical net identity.
(rule "Project: Drill spacing"
    (constraint hole_to_hole (min 0.2mm))
)

(rule "Project: Pad drill spacing"
    (condition "A.Type == 'Pad' && (A.Pad_Type == 'Through-hole' || A.Pad_Type == 'NPTH, mechanical') && B.Type == 'Pad' && (B.Pad_Type == 'Through-hole' || B.Pad_Type == 'NPTH, mechanical')")
    (constraint hole_to_hole (min 0.45mm))
)

# A conservative project extension of the pad-hole figure to mixed via/pad pairs.
(rule "Project: Mixed via and pad drill spacing"
    (condition "(A.Type == 'Via' && B.Type == 'Pad' && (B.Pad_Type == 'Through-hole' || B.Pad_Type == 'NPTH, mechanical')) || (B.Type == 'Via' && A.Type == 'Pad' && (A.Pad_Type == 'Through-hole' || A.Pad_Type == 'NPTH, mechanical'))")
    (constraint hole_to_hole (min 0.45mm))
)

(rule "Hansaem 2L 1oz: Copper clearance"
    (constraint clearance (min 0.125mm))
)

(rule "Project: SMD pad clearance"
    (condition "A.Type == 'Pad' && (A.Pad_Type == 'SMD' || A.Pad_Type == 'Edge connector') && B.Type == 'Pad' && (B.Pad_Type == 'SMD' || B.Pad_Type == 'Edge connector')")
    (constraint clearance (min 0.15mm))
)

(rule "Project: Copper to drill"
    (constraint hole_clearance (min 0.2mm))
)

(rule "Project: PTH drill to track"
    (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.isPlated() && B.Type == 'Track'")
    (constraint hole_clearance (min 0.28mm))
)

(rule "Hansaem 2L 1oz: Trace width"
    (constraint track_width (min 0.125mm))
)

# Retain the project's margin for every copper object, not just tracks.
# Hansaem minima are 0.3 mm at routed edges and 0.5 mm at V-cuts.
(rule "Project: Copper to board edge"
    (constraint edge_clearance (min 0.5mm))
)

(rule "Project: Silkscreen text stroke"
    (layer "?.SilkS")
    (condition "A.Type == 'Text' || A.Type == 'Text Box'")
    (constraint text_thickness (min 0.15mm))
)

(rule "Project: Silkscreen text height"
    (layer "?.SilkS")
    (condition "A.Type == 'Text' || A.Type == 'Text Box'")
    (constraint text_height (min 1mm))
)

(rule "Project: Silkscreen graphic stroke"
    (layer "?.SilkS")
    (condition "A.Type == 'Graphic' && (A.Layer == 'F.SilkS' || A.Layer == 'B.SilkS') && A.Line_Width > 0mm")
    (severity warning)
    (constraint assertion "A.Line_Width >= 0.15mm")
)

(rule "Project: Pad to silkscreen"
    (condition "A.Type == 'Pad' && ((A.existsOnLayer('F.Mask') && B.Layer == 'F.SilkS') || (A.existsOnLayer('B.Mask') && B.Layer == 'B.SilkS'))")
    (constraint silk_clearance (min 0.15mm))
)

# USB geometry retained as a 90 ohm target; Hansaem stackup is unconfirmed.
# See DESIGN_RULES.md for the calculator inputs and reference-plane requirements.
# The skew limit is a project target, not a USB compliance limit.
(rule "USB: differential routing defaults"
    (condition "A.inDiffPair('USB_D') || A.inDiffPair('/USB_CONN')")
    (constraint track_width (min 0.35mm) (opt 0.35mm))
    (constraint diff_pair_gap (min 0.15mm) (opt 0.15mm))
)

(rule "USB: coplanar ground clearance"
    (condition "((A.inDiffPair('USB_D') || A.inDiffPair('/USB_CONN')) && B.NetName == 'GND') || ((B.inDiffPair('USB_D') || B.inDiffPair('/USB_CONN')) && A.NetName == 'GND')")
    (constraint clearance (min 0.25mm))
)

(rule "USB: pair skew target"
    (condition "A.inDiffPair('USB_D') || A.inDiffPair('/USB_CONN')")
    (constraint skew (within_diff_pairs) (max 0.5mm))
)

# Preserve the manufacturing margin between power and ground pours.
(rule "Project: Different-net zone clearance"
    (condition "A.Type == 'Zone' && B.Type == 'Zone' && A.Net != B.Net")
    (constraint clearance (min 0.25mm))
)
