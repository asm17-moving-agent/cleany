<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find cleany_description)/urdf/dual_arm.xacro"/>
  <xacro:include filename="$(find cleany_description)/urdf/head_camera.xacro"/>

  <!-- Backend-neutral physical model shared by all top-level descriptions. -->
  <xacro:macro name="cleany_robot_geometry" params="">
    <link name="base_link">
      <visual>
        <origin xyz="0 0 0"/>
        <geometry><box size="0.6 0.64 0.76"/></geometry>
        <material name="cleany_white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0"/>
        <geometry><box size="0.6 0.64 0.76"/></geometry>
      </collision>
    </link>

    <!-- base_link +X is front and physical +Y is left. -->
    <xacro:cleany_arm side="left" side_sign="1" base_y="0.1552" base_yaw="3.14159265359"/>
    <!-- base_link +X is front and physical -Y is right. -->
    <xacro:cleany_arm side="right" side_sign="-1" base_y="-0.1552" base_yaw="0"/>
    <xacro:cleany_head_camera/>
  </xacro:macro>
</robot>
