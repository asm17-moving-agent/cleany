<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Retained simulation model; physical CAD uses cleany.urdf. -->
  <xacro:arg name="model_profile" default="jetson_20261009"/>
  <xacro:if value="${'$(arg model_profile)' != 'jetson_20261009'}">
    ${xacro.fatal('Unknown model_profile; choose jetson_20261009')}
  </xacro:if>
  <xacro:include filename="$(find cleany_description)/urdf/legacy_20261009/cleany_geometry.xacro"/>
</robot>
