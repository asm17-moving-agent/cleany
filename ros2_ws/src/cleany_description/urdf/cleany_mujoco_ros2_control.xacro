<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="cleany_mujoco_arm_joint" params="joint_name">
    <joint name="${joint_name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="cleany_mujoco_read_only_joint" params="joint_name">
    <joint name="${joint_name}">
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro
    name="cleany_mujoco_ros2_control"
    params="mujoco_model headless sim_speed_factor">
    <ros2_control name="MujocoSystem" type="system">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">${mujoco_model}</param>
        <param name="headless">${headless}</param>
        <param name="sim_speed_factor">${sim_speed_factor}</param>
        <param name="initial_keyframe">handeye_ros2_control_home</param>
      </hardware>

      <xacro:cleany_mujoco_arm_joint joint_name="left_shoulder_yaw_joint"/>
      <xacro:cleany_mujoco_arm_joint joint_name="left_shoulder_pitch_joint"/>
      <xacro:cleany_mujoco_arm_joint joint_name="left_elbow_pitch_joint"/>
      <xacro:cleany_mujoco_arm_joint joint_name="left_wrist_pitch_joint"/>
      <xacro:cleany_mujoco_arm_joint joint_name="left_wrist_roll_joint"/>
      <xacro:cleany_mujoco_arm_joint joint_name="right_shoulder_yaw_joint"/>
      <xacro:cleany_mujoco_arm_joint joint_name="right_shoulder_pitch_joint"/>
      <xacro:cleany_mujoco_arm_joint joint_name="right_elbow_pitch_joint"/>
      <xacro:cleany_mujoco_arm_joint joint_name="right_wrist_pitch_joint"/>
      <xacro:cleany_mujoco_arm_joint joint_name="right_wrist_roll_joint"/>
      <xacro:cleany_mujoco_read_only_joint joint_name="left_gripper_joint"/>
      <xacro:cleany_mujoco_read_only_joint joint_name="right_gripper_joint"/>
    </ros2_control>
  </xacro:macro>
</robot>
