<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="cleany_mujoco_arm_joint" params="joint_name initial_value">
    <joint name="${joint_name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_value}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="cleany_mujoco_read_only_joint" params="joint_name initial_value">
    <joint name="${joint_name}">
      <state_interface name="position">
        <param name="initial_value">${initial_value}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro
    name="cleany_mujoco_ros2_control"
    params="mujoco_model headless sim_speed_factor camera_publish_rate camera_name camera_frame_name enable_gripper_command
            left_shoulder_yaw_initial left_shoulder_pitch_initial left_elbow_pitch_initial left_wrist_pitch_initial left_wrist_roll_initial left_gripper_initial
            right_shoulder_yaw_initial right_shoulder_pitch_initial right_elbow_pitch_initial right_wrist_pitch_initial right_wrist_roll_initial right_gripper_initial">
    <ros2_control name="MujocoSystem" type="system">
      <hardware>
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">${mujoco_model}</param>
        <param name="headless">${headless}</param>
        <param name="sim_speed_factor">${sim_speed_factor}</param>
        <param name="camera_publish_rate">${camera_publish_rate}</param>
        <param name="initial_keyframe">handeye_ros2_control_home</param>
      </hardware>

      <!-- Humble mujoco_ros2_control 0.0.3 discovers MJCF cameras through
           hardware_info.sensors; that release has no CameraPlugin. -->
      <sensor name="${camera_name}">
        <param name="frame_name">${camera_frame_name}</param>
        <param name="info_topic">/${camera_name}/camera_info</param>
        <param name="image_topic">/${camera_name}/color</param>
        <param name="depth_topic">/${camera_name}/depth</param>
      </sensor>

      <xacro:cleany_mujoco_arm_joint joint_name="left_shoulder_yaw_joint" initial_value="${left_shoulder_yaw_initial}"/>
      <xacro:cleany_mujoco_arm_joint joint_name="left_shoulder_pitch_joint" initial_value="${left_shoulder_pitch_initial}"/>
      <xacro:cleany_mujoco_arm_joint joint_name="left_elbow_pitch_joint" initial_value="${left_elbow_pitch_initial}"/>
      <xacro:cleany_mujoco_arm_joint joint_name="left_wrist_pitch_joint" initial_value="${left_wrist_pitch_initial}"/>
      <xacro:cleany_mujoco_arm_joint joint_name="left_wrist_roll_joint" initial_value="${left_wrist_roll_initial}"/>
      <xacro:cleany_mujoco_arm_joint joint_name="right_shoulder_yaw_joint" initial_value="${right_shoulder_yaw_initial}"/>
      <xacro:cleany_mujoco_arm_joint joint_name="right_shoulder_pitch_joint" initial_value="${right_shoulder_pitch_initial}"/>
      <xacro:cleany_mujoco_arm_joint joint_name="right_elbow_pitch_joint" initial_value="${right_elbow_pitch_initial}"/>
      <xacro:cleany_mujoco_arm_joint joint_name="right_wrist_pitch_joint" initial_value="${right_wrist_pitch_initial}"/>
      <xacro:cleany_mujoco_arm_joint joint_name="right_wrist_roll_joint" initial_value="${right_wrist_roll_initial}"/>
      <xacro:if value="${enable_gripper_command}">
        <xacro:cleany_mujoco_arm_joint joint_name="left_gripper_joint" initial_value="${left_gripper_initial}"/>
        <xacro:cleany_mujoco_arm_joint joint_name="right_gripper_joint" initial_value="${right_gripper_initial}"/>
      </xacro:if>
      <xacro:unless value="${enable_gripper_command}">
        <xacro:cleany_mujoco_read_only_joint joint_name="left_gripper_joint" initial_value="${left_gripper_initial}"/>
        <xacro:cleany_mujoco_read_only_joint joint_name="right_gripper_joint" initial_value="${right_gripper_initial}"/>
      </xacro:unless>
    </ros2_control>
  </xacro:macro>
</robot>
