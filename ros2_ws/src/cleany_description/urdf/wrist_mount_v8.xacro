      <geometry>
        <box size="0.01255 0.0025 0.0025" />
      </geometry>
    </collision>
    <collision name="${side}_wrist_mount_v8_rear_clip_left_collision">
      <origin xyz="0.011755885557598 -0.0470171485988188 0.0613965244512633" rpy="-2.3219650109899 0 3.14159265358979" />
      <geometry>
        <box size="0.007 0.01 0.007" />
      </geometry>
    </collision>
    <collision name="${side}_wrist_mount_v8_rear_clip_right_collision">
      <origin xyz="-0.00929411444240196 -0.0470171485988188 0.0613965244512633" rpy="-2.3219650109899 0 3.14159265358979" />
