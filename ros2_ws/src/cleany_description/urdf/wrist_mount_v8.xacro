<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Geometry from mjcf/wrist_mount_v8.xml (handoff e78ac14), in Fixed_Jaw metres.
       Keep separate component collisions; the merged visual STL is not a solid.
       Attachment ignores the CAD export rounding (<1.3 um, <3 urad).
       Camera extrinsics, joint frames and inertias are managed separately. -->
  <xacro:macro name="cleany_wrist_mount_v8" params="side">
    <visual name="${side}_wrist_mount_v8_mount_visual">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://cleany_description/meshes/wrist_mount_v8/mount_legacy_jaw_m.stl" scale="1 1 1" />
      </geometry>
      <material name="${side}_wrist_mount_v8_mount_visual_material">
        <color rgba=".38 .08 .66 1" />
      </material>
    </visual>
    <collision name="${side}_wrist_mount_v8_case_back_collision">
      <origin xyz="0.00123088555759804 -0.0489895729952997 0.055450135462964" rpy="-2.3219650109899 0 3.14159265358979" />
      <geometry>
        <box size="0.0421 0.0507 0.004" />
      </geometry>
    </collision>
    <collision name="${side}_wrist_mount_v8_case_lip_left_collision">
      <origin xyz="0.021030885557598 -0.0466141748112739 0.0576682390374904" rpy="-2.3219650109899 0 3.14159265358979" />
      <geometry>
        <box size="0.0025 0.0507 0.0025" />
      </geometry>
    </collision>
    <collision name="${side}_wrist_mount_v8_case_lip_right_collision">
      <origin xyz="-0.018569114442402 -0.0466141748112739 0.0576682390374904" rpy="-2.3219650109899 0 3.14159265358979" />
      <geometry>
        <box size="0.0025 0.0507 0.0025" />
      </geometry>
    </collision>
    <collision name="${side}_wrist_mount_v8_case_lip_top_collision">
      <origin xyz="0.00123088555759804 -0.0630622659331465 0.0752827301867282" rpy="-2.3219650109899 0 3.14159265358979" />
      <geometry>
        <box size="0.0371 0.0025 0.0025" />
      </geometry>
    </collision>
    <collision name="${side}_wrist_mount_v8_case_lip_bottom_left_collision">
      <origin xyz="0.013505885557598 -0.0301660836894013 0.0400537478882526" rpy="-2.3219650109899 0 3.14159265358979" />
      <geometry>
        <box size="0.01255 0.0025 0.0025" />
