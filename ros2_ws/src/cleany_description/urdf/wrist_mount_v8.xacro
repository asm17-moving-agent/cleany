    <visual name="${side}_wrist_mount_v8_foot_screw_1_visual">
      <origin xyz="0.00123088555759804 -0.0566850165154868 0.0549" rpy="2.3219650109899 0 0" />
      <geometry>
        <mesh filename="package://cleany_description/meshes/wrist_mount_v8/components/foot_screw_1.stl" scale="1 1 1" />
