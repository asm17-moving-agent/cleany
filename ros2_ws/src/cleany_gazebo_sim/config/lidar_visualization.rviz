Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: RPLIDAR Scan
      Selectable: true
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Reliability Policy: Reliable
        Value: /scan
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 15
      Pitch: 1.0
      Yaw: 0.8
Window Geometry:
  Height: 800
  Width: 1000
