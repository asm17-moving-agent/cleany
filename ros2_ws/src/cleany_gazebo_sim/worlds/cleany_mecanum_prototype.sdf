<?xml version="1.0" ?>
<sdf version="1.7">
  <world name="cleany_mecanum_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- OGRE 1 avoids the OGRE2 texture-copy limitation on this WSLg stack. -->
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors"><render_engine>ogre</render_engine></plugin>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </visual>
      </link>
    </model>

    <!--
      This is a kinematic prototype, not a hardware-accurate XLeRobot model.
      The RASKOG body visual and wheel layout originate in the Cleany model.
      The launch file adds cleany_description to the Gazebo resource path so
      this world does not duplicate its STL assets.
    -->
    <model name="cleany_mecanum" xmlns:ignition="http://ignitionrobotics.org/schema">
      <!-- Matches the MuJoCo chassis origin; wheel centers remain at z=0.0635. -->
      <pose>0 0 0.38 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>20.0</mass>
          <inertia><ixx>0.30</ixx><iyy>0.30</iyy><izz>0.45</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.55 0.45 0.20</size></box></geometry>
        </collision>
        <visual name="raskog_body_visual">
          <!-- Rotated so the head camera and base +X use the same front. -->
          <pose>0.01668 -0.502 0.515 1.5708 0 3.14159265</pose>
          <geometry>
            <mesh>
              <uri>model://meshes/raskogbody.stl</uri>
              <scale>0.0009 0.001 0.0009</scale>
            </mesh>
          </geometry>
          <material><diffuse>0.12 0.30 0.75 1</diffuse></material>
        </visual>
      </link>

      <link name="rear_left_wheel">
        <pose>-0.15 0.255 -0.3165 -1.5707 0 0</pose>
        <inertial><mass>0.38</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="mecanum_contact"><geometry><sphere><radius>0.0635</radius></sphere></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_link">1 1 0</fdir1></ode></friction></surface></collision>
        <visual name="left_plate_visual"><pose>0 0 -0.0235 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.004</length></cylinder></geometry><material><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <visual name="right_plate_visual"><pose>0 0 0.0235 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.004</length></cylinder></geometry><material><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <visual name="hub_visual"><geometry><cylinder><radius>0.024</radius><length>0.051</length></cylinder></geometry><material><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <!-- CLEANY_REAR_LEFT_ROLLER_VISUALS -->
      </link>
      <link name="rear_right_wheel">
        <pose>-0.15 -0.255 -0.3165 -1.5707 0 0</pose>
        <inertial><mass>0.38</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="mecanum_contact"><geometry><sphere><radius>0.0635</radius></sphere></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_link">1 -1 0</fdir1></ode></friction></surface></collision>
        <visual name="left_plate_visual"><pose>0 0 -0.0235 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.004</length></cylinder></geometry><material><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <visual name="right_plate_visual"><pose>0 0 0.0235 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.004</length></cylinder></geometry><material><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <visual name="hub_visual"><geometry><cylinder><radius>0.024</radius><length>0.051</length></cylinder></geometry><material><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <!-- CLEANY_REAR_RIGHT_ROLLER_VISUALS -->
      </link>
      <link name="front_left_wheel">
        <pose>0.15 0.255 -0.3165 -1.5707 0 0</pose>
        <inertial><mass>0.38</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="mecanum_contact"><geometry><sphere><radius>0.0635</radius></sphere></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_link">1 -1 0</fdir1></ode></friction></surface></collision>
        <visual name="left_plate_visual"><pose>0 0 -0.0235 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.004</length></cylinder></geometry><material><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <visual name="right_plate_visual"><pose>0 0 0.0235 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.004</length></cylinder></geometry><material><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <visual name="hub_visual"><geometry><cylinder><radius>0.024</radius><length>0.051</length></cylinder></geometry><material><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <!-- CLEANY_FRONT_LEFT_ROLLER_VISUALS -->
      </link>
      <link name="front_right_wheel">
        <pose>0.15 -0.255 -0.3165 -1.5707 0 0</pose>
        <inertial><mass>0.38</mass><inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz></inertia></inertial>
        <collision name="mecanum_contact"><geometry><sphere><radius>0.0635</radius></sphere></geometry><surface><friction><ode><mu>1.0</mu><mu2>0.0</mu2><fdir1 ignition:expressed_in="base_link">1 1 0</fdir1></ode></friction></surface></collision>
        <visual name="left_plate_visual"><pose>0 0 -0.0235 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.004</length></cylinder></geometry><material><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <visual name="right_plate_visual"><pose>0 0 0.0235 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>0.004</length></cylinder></geometry><material><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <visual name="hub_visual"><geometry><cylinder><radius>0.024</radius><length>0.051</length></cylinder></geometry><material><diffuse>0.62 0.64 0.68 1</diffuse></material></visual>
        <!-- CLEANY_FRONT_RIGHT_ROLLER_VISUALS -->
      </link>

      <!--
        Fortress's MecanumDrive uses one continuous drive joint per wheel.
        The finite display range keeps Gazebo's generic position-controller
        panel readable while remaining effectively unbounded for simulation.
      -->
      <joint name="rear_left_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_left_wheel</child><axis><xyz expressed_in="base_link">0 1 0</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>1000000</effort></limit></axis></joint>
      <joint name="rear_right_wheel_joint" type="revolute"><parent>base_link</parent><child>rear_right_wheel</child><axis><xyz expressed_in="base_link">0 1 0</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>1000000</effort></limit></axis></joint>
      <joint name="front_left_wheel_joint" type="revolute"><parent>base_link</parent><child>front_left_wheel</child><axis><xyz expressed_in="base_link">0 1 0</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>1000000</effort></limit></axis></joint>
      <joint name="front_right_wheel_joint" type="revolute"><parent>base_link</parent><child>front_right_wheel</child><axis><xyz expressed_in="base_link">0 1 0</xyz><limit><lower>-1000000</lower><upper>1000000</upper><effort>1000000</effort></limit></axis></joint>

      <!-- Candidate RPLIDAR A1M8-R6 mount shared with the Harmonic profile.
           The physical mounting position remains subject to hardware review. -->
      <link name="lidar_link">
        <pose relative_to="lidar_mount">0 0 0 0 0 0</pose>
        <visual name="rplidar_a1_visual">
          <geometry><cylinder><radius>0.0484</radius><length>0.055</length></cylinder></geometry>
          <material><diffuse>0.10 0.10 0.12 1</diffuse></material>
        </visual>
        <sensor name="rplidar_a1" type="gpu_lidar">
          <topic>/model/cleany_mecanum/lidar/scan</topic>
          <always_on>true</always_on>
          <update_rate>5.5</update_rate>
          <visualize>false</visualize>
          <gz_frame_id>lidar_link</gz_frame_id>
          <lidar>
            <scan>
              <horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.141593</min_angle><max_angle>3.141593</max_angle></horizontal>
              <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
            </scan>
            <range><min>0.15</min><max>12.0</max><resolution>0.01</resolution></range>
          </lidar>
        </sensor>
      </link>
      <joint name="lidar_mount" type="fixed"><pose relative_to="base_link">0.32 0 -0.18 0 0 0</pose><parent>base_link</parent><child>lidar_link</child></joint>

      <!--
        MuJoCo top_base_link: the upper support that physically and visually
        connects the dual-arm mounts to the RASKOG chassis.
      -->
      <link name="top_base_link">
        <pose relative_to="top_base_mount">0 0 0 0 0 0</pose>
        <inertial><mass>0.2542</mass><inertia><ixx>0.0045</ixx><iyy>0.005</iyy><izz>0.0045</izz></inertia></inertial>
        <visual name="support_body"><pose>-0.44 -0.005 -0.6 0 0 0</pose><geometry><mesh><uri>model://meshes/topbase1.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
        <visual name="support_motor"><pose>-0.298 0.006 -0.715 0 0 3.14</pose><geometry><mesh><uri>model://meshes/topbase2.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry><material><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
      </link>
      <joint name="top_base_mount" type="fixed"><pose relative_to="base_link">0 0 0.35 0 0 3.14159265</pose><parent>base_link</parent><child>top_base_link</child></joint>

      <!-- MuJoCo camera inventory: one head RGBD unit plus two wrist RGB units. -->
      <link name="head_pan_link">
        <pose relative_to="head_pan_mount">0 0 0 0 0 0</pose>
        <visual name="head_pan_body"><pose>-0.335 -0.005 -0.923 0 0 0</pose><geometry><mesh><uri>model://meshes/tophead1.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
        <visual name="head_pan_motor"><pose>1.17 -0.009 0.262 3.14 -1.57 3.14</pose><geometry><mesh><uri>model://meshes/tophead4.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry><material><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
      </link>
      <link name="head_tilt_link">
        <pose relative_to="head_tilt_mount">0 0 0 0 0 0</pose>
        <visual name="head_tilt_body"><pose>0.16265 -0.006 -1.16815 0 0 0</pose><geometry><mesh><uri>model://meshes/tophead5.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
        <visual name="head_tilt_motor"><pose>0.16265 -0.006 -1.16815 0 0 0</pose><geometry><mesh><uri>model://meshes/tophead6.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry><material><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
      </link>
      <link name="head_camera_link">
        <pose relative_to="head_camera_mount">0 0 0 0 0 0</pose>
        <sensor name="head_realsense_rgb" type="camera"><gz_frame_id>head_camera_rgb_optical_frame</gz_frame_id><topic>/model/cleany_mecanum/head_camera/rgb/image</topic><always_on>true</always_on><update_rate>15</update_rate><visualize>false</visualize><camera><horizontal_fov>0.915</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>10.0</far></clip></camera></sensor>
        <sensor name="head_realsense_depth" type="depth_camera"><gz_frame_id>head_camera_depth_optical_frame</gz_frame_id><topic>/model/cleany_mecanum/head_camera/depth/image</topic><always_on>true</always_on><update_rate>15</update_rate><visualize>false</visualize><camera><horizontal_fov>0.857</horizontal_fov><image><width>640</width><height>480</height></image><clip><near>0.1</near><far>10.0</far></clip></camera></sensor>
      </link>
      <joint name="head_pan_mount" type="fixed"><pose relative_to="top_base_link">-0.103 0 0.323 0 0 0</pose><parent>top_base_link</parent><child>head_pan_link</child></joint>
      <joint name="head_tilt_mount" type="fixed"><pose relative_to="head_pan_link">0.001 0.002 0.09815 0 0 3.14159265</pose><parent>head_pan_link</parent><child>head_tilt_link</child></joint>
      <!-- The physical head camera link is level; its optical-frame rotation is internal to the sensor. -->
      <joint name="head_camera_mount" type="fixed"><pose relative_to="head_tilt_link">0.025 0 0.03 0 0 0</pose><parent>head_tilt_link</parent><child>head_camera_link</child></joint>

      <link name="left_wrist_camera_link">
        <pose relative_to="left_wrist_camera_mount">0 0 0 0 0 0</pose>
        <visual name="camera_body"><pose>-0.015 -0.026 0 0 0 0</pose><geometry><mesh><uri>model://meshes/XLeRobot_camera1.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
        <visual name="camera_motor"><pose>-0.015 -0.026 0 0 0 0</pose><geometry><mesh><uri>model://meshes/XLeRobot_camera2.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry><material><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <!-- Converted from MuJoCo left_wrist_rgb xyaxes: Gazebo cameras use +X as forward. -->
        <sensor name="left_wrist_rgb" type="camera"><gz_frame_id>left_wrist_rgb_optical_frame</gz_frame_id><pose>-0.00833 0.01494 0.003872 0 0.007614 -0.436597</pose><topic>/model/cleany_mecanum/left_wrist_camera/rgb/image</topic><always_on>true</always_on><update_rate>15</update_rate><visualize>false</visualize><camera><horizontal_fov>2.16</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>0.05</near><far>5.0</far></clip></camera></sensor>
      </link>
      <link name="right_wrist_camera_link">
        <pose relative_to="right_wrist_camera_mount">0 0 0 0 0 0</pose>
        <visual name="camera_body"><pose>-0.015 -0.026 0 0 0 0</pose><geometry><mesh><uri>model://meshes/XLeRobot_camera1.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual>
        <visual name="camera_motor"><pose>-0.015 -0.026 0 0 0 0</pose><geometry><mesh><uri>model://meshes/XLeRobot_camera2.stl</uri><scale>0.001 0.001 0.001</scale></mesh></geometry><material><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
        <!-- Converted from MuJoCo right_wrist_rgb xyaxes: Gazebo cameras use +X as forward. -->
        <sensor name="right_wrist_rgb" type="camera"><gz_frame_id>right_wrist_rgb_optical_frame</gz_frame_id><pose>-0.00833 0.01494 0.003872 0 0.007614 -0.436597</pose><topic>/model/cleany_mecanum/right_wrist_camera/rgb/image</topic><always_on>true</always_on><update_rate>15</update_rate><visualize>false</visualize><camera><horizontal_fov>2.16</horizontal_fov><image><width>640</width><height>360</height><format>R8G8B8</format></image><clip><near>0.05</near><far>5.0</far></clip></camera></sensor>
      </link>
      <!-- MuJoCo euler uses a different convention; these are the equivalent SDF RPY mount poses. -->
      <joint name="left_wrist_camera_mount" type="fixed"><pose relative_to="left_fixed_jaw">0 -0.022 0.05 1.5708 0 -1.5708</pose><parent>left_fixed_jaw</parent><child>left_wrist_camera_link</child></joint>
      <joint name="right_wrist_camera_mount" type="fixed"><pose relative_to="right_fixed_jaw">0 -0.021 0.05 1.5708 0 -1.5708</pose><parent>right_fixed_jaw</parent><child>right_wrist_camera_link</child></joint>

      <!--
        The arm mass properties and extended collision/render meshes follow
        the canonical description. Gravity remains disabled until an arm
        actuator/controller is introduced.
      -->
      <link name="left_arm_base"><pose relative_to="left_arm_mount">0 0 0 0 0 0</pose><gravity>false</gravity><inertial><pose>0.0137179 -0.0000519711 0.0334843 0 0 0</pose><mass>0.147</mass><inertia><ixx>0.000114686</ixx><iyy>0.000136117</iyy><izz>0.000130364</izz><ixy>-0.000000459787</ixy><ixz>0.00000497151</ixz><iyz>0.0000000975275</iyz></inertia></inertial><collision name="body_collision"><geometry><mesh><uri>model://meshes/Base.stl.convex.stl</uri></mesh></geometry></collision><collision name="motor_collision"><geometry><mesh><uri>model://meshes/Base_Motor.stl.convex.stl</uri></mesh></geometry></collision><visual name="base"><geometry><mesh><uri>model://meshes/Base.stl</uri></mesh></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual><visual name="motor"><geometry><mesh><uri>model://meshes/Base_Motor.stl</uri></mesh></geometry><material><diffuse>0.18 0.18 0.20 1</diffuse></material></visual></link>
      <link name="left_rotation_pitch"><pose relative_to="left_shoulder_yaw_joint">0 0 0 0 0 0</pose><gravity>false</gravity><inertial><pose>-0.0307604 -0.0000166727 -0.0252713 0 0 0</pose><mass>0.100006</mass><inertia><ixx>0.000083759</ixx><iyy>0.0000810403</iyy><izz>0.0000239783</izz><ixy>0.0000000755525</ixy><ixz>-0.00000116342</ixz><iyz>0.000000154663</iyz></inertia></inertial><collision name="body_collision"><geometry><mesh><uri>model://meshes/Rotation_Pitch.stl.convex.stl</uri></mesh></geometry></collision><collision name="motor_collision"><geometry><mesh><uri>model://meshes/Rotation_Pitch_Motor.stl.convex.stl</uri></mesh></geometry></collision><visual name="body"><geometry><mesh><uri>model://meshes/Rotation_Pitch.stl</uri></mesh></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual><visual name="motor"><geometry><mesh><uri>model://meshes/Rotation_Pitch_Motor.stl</uri></mesh></geometry><material><diffuse>0.18 0.18 0.20 1</diffuse></material></visual></link>
      <link name="left_upper_arm"><pose relative_to="left_shoulder_pitch_joint">0 0 0 0 0 0</pose><gravity>false</gravity><inertial><pose>0.00011909447145 0.13366336448 0.00941424883693 0 0 0</pose><mass>0.1185</mass><inertia><ixx>0.000344882383932</ixx><iyy>0.0000390640385918</iyy><izz>0.000341356582549</izz><ixy>0.0000000126253142805</ixy><ixz>-0.0000000018457009038</ixz><iyz>-0.0000322497618493</iyz></inertia></inertial><collision name="body_collision"><pose>-0.0001 0.0651 -0.012 1.57079632679 0 -1.57079632679</pose><geometry><mesh><uri>model://meshes/Upper_Arm_5cm.stl</uri></mesh></geometry></collision><collision name="motor_collision"><pose>0 0.05 0 0 0 0</pose><geometry><mesh><uri>model://meshes/Upper_Arm_Motor.stl.convex.stl</uri></mesh></geometry></collision><visual name="sockets"><pose>-0.0001 0.0651 -0.012 1.57079632679 0 -1.57079632679</pose><geometry><mesh><uri>model://meshes/Upper_Arm_5cm_Sockets.stl</uri></mesh></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual><visual name="carbon"><pose>-0.0001 0.0651 -0.012 1.57079632679 0 -1.57079632679</pose><geometry><mesh><uri>model://meshes/Upper_Arm_5cm_Carbon.stl</uri></mesh></geometry><material><diffuse>0.10 0.10 0.12 1</diffuse></material></visual><visual name="motor"><pose>0 0.05 0 0 0 0</pose><geometry><mesh><uri>model://meshes/Upper_Arm_Motor.stl</uri></mesh></geometry><material><diffuse>0.18 0.18 0.20 1</diffuse></material></visual></link>
      <link name="left_lower_arm"><pose relative_to="left_elbow_pitch_joint">0 0 0 0 0 0</pose><gravity>false</gravity><inertial><pose>-0.000705377693495 0.003222361186 0.133834080359 0 0 0</pose><mass>0.093</mass><inertia><ixx>0.000317919847018</ixx><iyy>0.000326130407587</iyy><izz>0.0000182344857592</izz><ixy>-0.000000245304506082</ixy><ixz>-0.00000442747241607</ixz><iyz>-0.000011286233547</iyz></inertia></inertial><collision name="body_collision"><pose>-0.0025 0.032 0.065 0 1.57079632679 0</pose><geometry><mesh><uri>model://meshes/Lower_Arm_5cm.stl</uri></mesh></geometry></collision><collision name="motor_collision"><pose>0 0 0.05 0 0 0</pose><geometry><mesh><uri>model://meshes/Lower_Arm_Motor.stl.convex.stl</uri></mesh></geometry></collision><visual name="sockets"><pose>-0.0025 0.032 0.065 0 1.57079632679 0</pose><geometry><mesh><uri>model://meshes/Lower_Arm_5cm_Sockets.stl</uri></mesh></geometry><material><diffuse>0.85 0.85 0.85 1</diffuse></material></visual><visual name="carbon"><pose>-0.0025 0.032 0.065 0 1.57079632679 0</pose><geometry><mesh><uri>model://meshes/Lower_Arm_5cm_Carbon.stl</uri></mesh></geometry><material><diffuse>0.10 0.10 0.12 1</diffuse></material></visual><visual name="motor"><pose>0 0 0.05 0 0 0</pose><geometry><mesh><uri>model://meshes/Lower_Arm_Motor.stl</uri></mesh></geometry><material><diffuse>0.18 0.18 0.20 1</diffuse></material></visual></link>
