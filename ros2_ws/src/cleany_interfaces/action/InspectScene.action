# 1단계 검출기 프롬프트입니다. 빈 값이면 설정된 기본값을 사용합니다.
# 2단계는 캐시된 검출 결과를 사용하며 이 필드를 무시합니다.
string query

# 베이스가 고정된 같은 책상 작업에는 같은 session을 사용합니다. 빈 값이면 추적을 끕니다.
string tracking_session_id

# 검출만 수행하는 1단계에서는 두 필드가 빈 값 또는 0입니다. 2단계에서는
# 1단계가 반환한 snapshot ID와 해당 snapshot의 물체 ID 하나를 제공합니다.
string snapshot_id
uint32 selected_object_id
---
uint8 ERROR_NONE=0
uint8 ERROR_RGBD_TIMEOUT=1
uint8 ERROR_DETECTOR_API=2
uint8 ERROR_DETECTOR_RESPONSE=3
uint8 ERROR_MASK=4
uint8 ERROR_DEPTH=5
uint8 ERROR_PLANE=6
uint8 ERROR_TF=7
uint8 ERROR_CANCELLED=8
uint8 ERROR_SNAPSHOT_NOT_FOUND=9
uint8 ERROR_INVALID_SELECTION=10
uint8 ERROR_INTERNAL=255

bool success
uint8 error_code
string message

# 번호가 부여된 1단계 전체 검출 결과입니다. client가 별도 ROS 메시지를 보관하지
# 않아도 선택 ID를 연결할 수 있도록 2단계에서도 캐시된 배열을 반복합니다.
DetectedObject2DArray detections

# 1단계에서는 비어 있으며 2단계에서는 선택된 물체만 포함합니다.
DetectedObject3DArray objects

# 1단계에서는 비어 있습니다. 2단계 점군은 objects.header와 설정된 대상 좌표계 및
# 촬영 시각을 공유합니다. target_cloud는 선택 마스크의 점을 담고,
# context_cloud는 물체 주변의 설정된 국소 영역을 포함합니다.
sensor_msgs/PointCloud2 target_cloud
sensor_msgs/PointCloud2 context_cloud
---
uint8 STAGE_WAITING_FOR_RGBD=0
uint8 STAGE_DETECTING=1
uint8 STAGE_SEGMENTING=2
uint8 STAGE_RECONSTRUCTING=3
uint8 STAGE_TRANSFORMING=4

uint8 stage

# 이 단계에서 확인된 개수입니다. detections_2d는 1단계 전체 검출을 포함하며
# objects_3d는 선택한 물체를 재구성하기 전까지 0입니다.
uint32 detections_2d
uint32 objects_3d
string message
