<?xml version="1.0"?>
<package format="3">
  <name>cleany_mission_manager</name>
  <version>0.0.1</version>
  <description>Cleany mission lifecycle and FSM manager.</description>
  <maintainer email="team@example.com">Cleany Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>cleany_interfaces</exec_depend>
  <exec_depend>py_trees</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>unique_identifier_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>cleany_control_bridge</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
