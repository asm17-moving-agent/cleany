<?xml version="1.0"?>
<robot name="cleany">
  <group name="left_arm">
    <chain base_link="base_link" tip_link="left_gripper_frame"/>
  </group>
  <group name="right_arm">
    <chain base_link="base_link" tip_link="right_gripper_frame"/>
  </group>

  <group_state name="left_home" group="left_arm">
    <joint name="left_shoulder_yaw_joint" value="0.0"/>
    <joint name="left_shoulder_pitch_joint" value="0.0"/>
    <joint name="left_elbow_pitch_joint" value="0.0"/>
    <joint name="left_wrist_pitch_joint" value="0.0"/>
    <joint name="left_wrist_roll_joint" value="0.0"/>
  </group_state>
  <group_state name="right_home" group="right_arm">
    <joint name="right_shoulder_yaw_joint" value="0.0"/>
    <joint name="right_shoulder_pitch_joint" value="0.0"/>
    <joint name="right_elbow_pitch_joint" value="0.0"/>
    <joint name="right_wrist_pitch_joint" value="0.0"/>
    <joint name="right_wrist_roll_joint" value="0.0"/>
  </group_state>

  <!-- Keep the matrix conservative: only direct parent/child collision pairs are disabled. -->
  <disable_collisions link1="base_link" link2="left_shoulder_yaw_link" reason="Adjacent"/>
  <disable_collisions link1="left_shoulder_yaw_link" link2="left_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="left_upper_arm_link" link2="left_lower_arm_link" reason="Adjacent"/>
  <disable_collisions link1="left_lower_arm_link" link2="left_wrist_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="left_wrist_pitch_link" link2="left_gripper_frame" reason="Adjacent"/>
  <disable_collisions link1="left_gripper_frame" link2="left_moving_jaw_link" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="right_shoulder_yaw_link" reason="Adjacent"/>
  <disable_collisions link1="right_shoulder_yaw_link" link2="right_upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="right_upper_arm_link" link2="right_lower_arm_link" reason="Adjacent"/>
  <disable_collisions link1="right_lower_arm_link" link2="right_wrist_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="right_wrist_pitch_link" link2="right_gripper_frame" reason="Adjacent"/>
  <disable_collisions link1="right_gripper_frame" link2="right_moving_jaw_link" reason="Adjacent"/>
</robot>
