<?xml version="1.0"?>
<robot name="cleany" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="include_head_camera" default="false"/>
  <xacro:include filename="cleany.srdf"/>
  <xacro:if value="$(arg include_head_camera)">
    <!-- Only mechanical parent/child interfaces; tilt versus support remains checked. -->
    <disable_collisions link1="base_link" link2="top_base_link" reason="Adjacent"/>
    <disable_collisions link1="top_base_link" link2="head_pan_link" reason="Adjacent"/>
    <disable_collisions link1="head_pan_link" link2="head_tilt_link" reason="Adjacent"/>
    <disable_collisions link1="head_tilt_link" link2="head_camera_link" reason="Adjacent"/>
  </xacro:if>
</robot>
