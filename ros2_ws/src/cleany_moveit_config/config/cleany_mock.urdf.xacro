<?xml version="1.0"?>
<robot name="cleany" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Reuse the canonical geometry; this file only adds a mock ros2_control system. -->
  <xacro:include filename="$(find cleany_description)/urdf/cleany.urdf.xacro"/>

  <xacro:macro name="cleany_mock_joint" params="joint_name">
    <joint name="${joint_name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="CleanyMockSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>

    <xacro:cleany_mock_joint joint_name="left_shoulder_yaw_joint"/>
    <xacro:cleany_mock_joint joint_name="left_shoulder_pitch_joint"/>
    <xacro:cleany_mock_joint joint_name="left_elbow_pitch_joint"/>
    <xacro:cleany_mock_joint joint_name="left_wrist_pitch_joint"/>
    <xacro:cleany_mock_joint joint_name="left_wrist_roll_joint"/>
    <xacro:cleany_mock_joint joint_name="left_gripper_joint"/>
    <xacro:cleany_mock_joint joint_name="right_shoulder_yaw_joint"/>
    <xacro:cleany_mock_joint joint_name="right_shoulder_pitch_joint"/>
    <xacro:cleany_mock_joint joint_name="right_elbow_pitch_joint"/>
    <xacro:cleany_mock_joint joint_name="right_wrist_pitch_joint"/>
    <xacro:cleany_mock_joint joint_name="right_wrist_roll_joint"/>
    <xacro:cleany_mock_joint joint_name="right_gripper_joint"/>
  </ros2_control>
</robot>
