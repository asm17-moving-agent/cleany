<?xml version="1.0"?>
<robot name="cleany" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="include_head_camera" default="false"/>
  <xacro:arg name="head_tilt_initial" default="0.405"/>
  <!-- Reuse the canonical geometry; this file only adds a mock ros2_control system. -->
  <xacro:include filename="$(find cleany_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find cleany_description)/urdf/cleany_geometry.xacro"/>
  <xacro:include filename="$(find cleany_description)/urdf/head_camera.xacro"/>

  <xacro:cleany_robot_geometry/>
  <xacro:if value="$(arg include_head_camera)">
    <xacro:cleany_head_camera/>
  </xacro:if>

  <xacro:macro name="cleany_mock_joint" params="joint_name initial_value:=0.0">
    <joint name="${joint_name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial_value}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <ros2_control name="CleanyMockSystem" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>

    <xacro:cleany_mock_joint joint_name="left_shoulder_yaw_joint"/>
    <xacro:cleany_mock_joint joint_name="left_shoulder_pitch_joint"/>
    <xacro:cleany_mock_joint joint_name="left_elbow_pitch_joint"/>
    <xacro:cleany_mock_joint joint_name="left_wrist_pitch_joint"/>
    <xacro:cleany_mock_joint joint_name="left_wrist_roll_joint"/>
    <xacro:cleany_mock_joint joint_name="left_gripper_joint"/>
    <xacro:cleany_mock_joint joint_name="right_shoulder_yaw_joint"/>
    <xacro:cleany_mock_joint joint_name="right_shoulder_pitch_joint"/>
    <xacro:cleany_mock_joint joint_name="right_elbow_pitch_joint"/>
    <xacro:cleany_mock_joint joint_name="right_wrist_pitch_joint"/>
    <xacro:cleany_mock_joint joint_name="right_wrist_roll_joint"/>
    <xacro:cleany_mock_joint joint_name="right_gripper_joint"/>
    <xacro:if value="$(arg include_head_camera)">
      <xacro:cleany_mock_joint joint_name="head_pan_joint" initial_value="0.023"/>
      <xacro:cleany_mock_joint joint_name="head_tilt_joint" initial_value="$(arg head_tilt_initial)"/>
    </xacro:if>
  </ros2_control>
</robot>
