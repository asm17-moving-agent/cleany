Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ''
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
    - Class: moveit_rviz_plugin/MotionPlanning
      Enabled: true
      Move Group Namespace: ''
      Name: MotionPlanning
      Planning Group: left_arm
      Planning Request:
        Planning Time: 5
        Query Goal State: true
        Query Start State: false
      Planned Path:
        Loop Animation: false
        State Display Time: 0.05 s
        Trail Step Size: 1
      Robot Description: robot_description
      Scene Geometry:
        Scene Alpha: 0.9
      Scene Robot:
        Robot Alpha: 0.5
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic: /grasp_demo/markers
      Name: Grasp Candidates
      Namespaces:
        can_grasp_approach: true
        can_grasp_candidates: true
        can_grasp_status: true
        detected_can: true
        grasp_approach: true
        grasp_candidates: true
        grasp_status: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0.45
      Name: Current View
      Pitch: 0.45
      Target Frame: base_link
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1440
