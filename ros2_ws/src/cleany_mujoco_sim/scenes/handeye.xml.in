<mujoco model="cleany_handeye_scene">
  <include file="@CLEANY_MJCF_PATH@"/>

  <option timestep="0.002" gravity="0 0 -9.80665" integrator="implicitfast"
          noslip_iterations="5">
    <flag multiccd="enable"/>
  </option>

  <statistic center="0.35 0.1 0.48" extent="1.15"/>

  <visual>
    <headlight active="0"/>
    <rgba haze="0.12 0.16 0.20 1"/>
    <global azimuth="135" elevation="-22" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <texture type="skybox" name="handeye_skybox" builtin="gradient"
             rgb1="0.34 0.40 0.48" rgb2="0.08 0.10 0.14"
             width="512" height="3072"/>
    <texture type="2d" name="handeye_floor_texture" builtin="checker"
             rgb1="0.18 0.18 0.18" rgb2="0.24 0.24 0.24"
             width="256" height="256"/>
    <material name="handeye_floor_material" texture="handeye_floor_texture"
              texuniform="true" texrepeat="6 6" reflectance="0.05"/>
    <material name="handeye_table_material" rgba="0.28 0.30 0.32 1"
              specular="0.05" shininess="0.1"/>
    <material name="handeye_stand_material" rgba="0.12 0.14 0.16 1"
              specular="0.1" shininess="0.2"/>
    <material name="charuco_white" rgba="1 1 1 1"
              specular="0" shininess="0"/>
    <material name="charuco_black" rgba="0.005 0.005 0.005 1"
              specular="0" shininess="0"/>
  </asset>

  <worldbody>
    <light name="handeye_key_light" pos="0.25 -0.35 1.65"
           dir="0.2 0.25 -1" directional="true"
           diffuse="0.78 0.78 0.78" specular="0.05 0.05 0.05"/>
    <light name="handeye_fill_light" pos="0.80 0.65 1.15"
           dir="-0.3 -0.25 -1" directional="true"
           diffuse="0.35 0.35 0.35" specular="0 0 0"/>
    <geom name="handeye_floor" type="plane" size="0 0 0.05"
          material="handeye_floor_material" contype="1" conaffinity="1"/>

    <!-- All fixture bodies omit joints and are therefore fixed to world. -->
    <body name="handeye_table" pos="0.68 0.18 0.48">
      <geom name="handeye_table_top" type="box" size="0.30 0.35 0.02"
            material="handeye_table_material" contype="1" conaffinity="1"/>
    </body>
    <body name="handeye_target_stand">
      <geom name="handeye_stand_base" type="box" pos="0.69 0.18 0.51"
            size="0.10 0.15 0.01" material="handeye_stand_material"
            contype="1" conaffinity="1"/>
      <geom name="handeye_stand_post" type="box" pos="0.69 0.18 0.61"
            size="0.025 0.025 0.09" material="handeye_stand_material"
            contype="1" conaffinity="1"/>
      <geom name="handeye_stand_crossbar" type="box" pos="0.69 0.18 0.70"
            size="0.035 0.12 0.015" material="handeye_stand_material"
            contype="1" conaffinity="1"/>
    </body>

    <!-- target frame: OpenCV 4.5 +X right, +Y up, +Z out of the printed face. -->
    <body name="charuco_target" pos="0.65 0.285 0.705"
