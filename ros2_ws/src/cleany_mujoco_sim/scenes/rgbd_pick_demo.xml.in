<mujoco model="cleany_rgbd_pick_demo">
  <include file="@CLEANY_MJCF_PATH@"/>

  <option timestep="0.002" gravity="0 0 -9.80665" integrator="implicitfast"
          noslip_iterations="5">
    <flag multiccd="enable"/>
  </option>

  <statistic center="0.6 0 0.55" extent="1.5"/>

  <visual>
    <quality offsamples="1"/>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.35 0.35 0.35"
               specular="0 0 0"/>
    <rgba haze="0.15 0.20 0.25 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.25 0.35 0.45"
             rgb2="0.02 0.02 0.02" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker"
             rgb1="0.12 0.12 0.12" rgb2="0.18 0.18 0.18"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.05"/>
    <material name="tabletop" rgba="0.55 0.36 0.20 1"
              specular="0.05" shininess="0.1"/>
    <material name="pick_box_material" rgba="0.12 0.42 0.92 1"/>
    <material name="pick_can_material" rgba="0.92 0.18 0.12 1"
              specular="0.2" shininess="0.3"/>
  </asset>

  <worldbody>
    <light pos="0.55 0 1.6" dir="0 0 -1" directional="true"/>
    <light pos="0.15 -0.7 1.2" dir="0.4 0.7 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane"
          material="groundplane" contype="1" conaffinity="1"/>

    <!-- X depth 0.77 m, Y width 1.20 m; top is world Z=0.725 m. -->
    <body name="pick_table" pos="0.635 -0.002 0.710">
      <geom name="pick_tabletop" type="box" size="0.385 0.600 0.015"
            material="tabletop" contype="1" conaffinity="1"/>
    </body>

    <!-- Fixed perception/IK targets for the first position-only demo. -->
    <body name="pick_box" pos="0.560 -0.160 0.765">
      <geom name="pick_box_geom" type="box" size="0.050 0.040 0.040"
            material="pick_box_material" contype="1" conaffinity="1"/>
    </body>
    <body name="pick_can" pos="0.540 0.160 0.775">
      <geom name="pick_can_geom" type="cylinder" size="0.035 0.050"
            material="pick_can_material" contype="1" conaffinity="1"/>
    </body>
  </worldbody>
</mujoco>
