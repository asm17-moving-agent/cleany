<mujoco model="cleany_study_cafe_scene">
  <include file="@CLEANY_MJCF_PATH@"/>

  <option timestep="0.002" gravity="0 0 -9.80665" integrator="implicitfast"
          noslip_iterations="5">
    <flag multiccd="enable"/>
  </option>

  <statistic center="0 0 1" extent="7.5"/>

  <visual>
    <headlight active="1" diffuse="0.35 0.35 0.35"
               ambient="0.30 0.30 0.30" specular="0 0 0"/>
    <rgba haze="0.82 0.83 0.84 1"/>
    <global azimuth="120" elevation="-30"/>
  </visual>

  <asset>
    <mesh name="study_cafe_wallet_mesh"
          file="@CLEANY_STUDY_CAFE_ASSET_DIR@/study_cafe_wallet.obj"/>
    <texture type="skybox" builtin="gradient" rgb1="0.82 0.83 0.84"
             rgb2="0.55 0.57 0.60" width="512" height="3072"/>
    <texture type="2d" name="study_cafe_floor_texture" builtin="checker"
             rgb1="0.69 0.67 0.62" rgb2="0.62 0.60 0.55"
             width="512" height="512"/>
    <material name="study_cafe_floor" texture="study_cafe_floor_texture"
              texuniform="true" texrepeat="12 11" reflectance="0.05"
              specular="0.05" shininess="0.1"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane"
          material="study_cafe_floor" contype="1" conaffinity="1"
          condim="4" friction="1 0.005 0.0001"/>
    @CLEANY_STUDY_CAFE_ENVIRONMENT@
  </worldbody>
</mujoco>
