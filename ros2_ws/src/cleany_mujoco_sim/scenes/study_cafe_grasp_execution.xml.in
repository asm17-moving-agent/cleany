<mujoco model="cleany_study_cafe_grasp_execution">
  <!-- Camera materialization contract: @CLEANY_STUDY_CAFE_HEAD_CAMERA_CONTRACT@ -->
  <include file="@CLEANY_MJCF_PATH@"/>

  <option timestep="0.001" gravity="0 0 -9.80665" integrator="implicitfast"
          solver="Newton" iterations="100" ls_iterations="20"
          noslip_iterations="20">
    <flag multiccd="enable"/>
  </option>

  <statistic center="-3.13 -3.60 0.80" extent="1.8"/>

  <visual>
    <quality offsamples="1"/>
    <headlight active="1" diffuse="0.35 0.35 0.35"
               ambient="0.30 0.30 0.30" specular="0 0 0"/>
    <rgba haze="0.82 0.83 0.84 1"/>
    <global azimuth="180" elevation="-25" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <mesh name="study_cafe_wallet_mesh"
          file="@CLEANY_STUDY_CAFE_ASSET_DIR@/study_cafe_wallet.obj"/>
    <texture type="skybox" builtin="gradient" rgb1="0.82 0.83 0.84"
             rgb2="0.55 0.57 0.60" width="512" height="3072"/>
    <texture type="2d" name="study_cafe_grasp_floor_texture"
             builtin="checker" rgb1="0.69 0.67 0.62"
             rgb2="0.62 0.60 0.55" width="512" height="512"/>
    <material name="study_cafe_grasp_floor"
              texture="study_cafe_grasp_floor_texture" texuniform="true"
              texrepeat="12 11" reflectance="0.05" specular="0.05"
              shininess="0.1"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane"
          material="study_cafe_grasp_floor" contype="1" conaffinity="1"
          condim="4" friction="1 0.005 0.0001"/>
    @CLEANY_STUDY_CAFE_ENVIRONMENT@
  </worldbody>

  <!-- Simulation-only jaw friction; expanded across the paper cup / LEGO compound geoms. -->
  <contact>
    <!-- Rigid wallet proxy: same original mixed friction, stiff jaw contact. -->
    <pair name="wallet_left_fixed_1" geom1="study_cafe_wallet_collision" geom2="left_fixed_jaw_contact_1" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="wallet_left_fixed_2" geom1="study_cafe_wallet_collision" geom2="left_fixed_jaw_contact_2" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="wallet_left_moving_1" geom1="study_cafe_wallet_collision" geom2="left_moving_jaw_contact_1" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="wallet_left_moving_2" geom1="study_cafe_wallet_collision" geom2="left_moving_jaw_contact_2" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="wallet_left_moving_3" geom1="study_cafe_wallet_collision" geom2="left_moving_jaw_contact_3" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="wallet_right_fixed_1" geom1="study_cafe_wallet_collision" geom2="right_fixed_jaw_contact_1" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="wallet_right_fixed_2" geom1="study_cafe_wallet_collision" geom2="right_fixed_jaw_contact_2" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="wallet_right_moving_1" geom1="study_cafe_wallet_collision" geom2="right_moving_jaw_contact_1" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="wallet_right_moving_2" geom1="study_cafe_wallet_collision" geom2="right_moving_jaw_contact_2" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="wallet_right_moving_3" geom1="study_cafe_wallet_collision" geom2="right_moving_jaw_contact_3" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <!-- Rigid tissue proxy: preserve mixed friction, prevent numerical penetration. -->
    <pair name="tissue_left_fixed_1" geom1="study_cafe_tissue_collision" geom2="left_fixed_jaw_contact_1" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_left_fixed_2" geom1="study_cafe_tissue_collision" geom2="left_fixed_jaw_contact_2" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_left_moving_1" geom1="study_cafe_tissue_collision" geom2="left_moving_jaw_contact_1" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_left_moving_2" geom1="study_cafe_tissue_collision" geom2="left_moving_jaw_contact_2" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_left_moving_3" geom1="study_cafe_tissue_collision" geom2="left_moving_jaw_contact_3" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_right_fixed_1" geom1="study_cafe_tissue_collision" geom2="right_fixed_jaw_contact_1" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_right_fixed_2" geom1="study_cafe_tissue_collision" geom2="right_fixed_jaw_contact_2" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_right_moving_1" geom1="study_cafe_tissue_collision" geom2="right_moving_jaw_contact_1" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_right_moving_2" geom1="study_cafe_tissue_collision" geom2="right_moving_jaw_contact_2" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_right_moving_3" geom1="study_cafe_tissue_collision" geom2="right_moving_jaw_contact_3" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <!-- Rigid thin-shell cup: stiff contact prevents jaw penetration through walls.
         This is not a deformable paper model; friction and actuator limits unchanged. -->
    <pair name="cup_left_fixed_1" geom1="study_cafe_cup_collision" geom2="left_fixed_jaw_contact_1" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_left_fixed_2" geom1="study_cafe_cup_collision" geom2="left_fixed_jaw_contact_2" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_left_moving_1" geom1="study_cafe_cup_collision" geom2="left_moving_jaw_contact_1" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_left_moving_2" geom1="study_cafe_cup_collision" geom2="left_moving_jaw_contact_2" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_left_moving_3" geom1="study_cafe_cup_collision" geom2="left_moving_jaw_contact_3" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_right_fixed_1" geom1="study_cafe_cup_collision" geom2="right_fixed_jaw_contact_1" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_right_fixed_2" geom1="study_cafe_cup_collision" geom2="right_fixed_jaw_contact_2" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_right_moving_1" geom1="study_cafe_cup_collision" geom2="right_moving_jaw_contact_1" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_right_moving_2" geom1="study_cafe_cup_collision" geom2="right_moving_jaw_contact_2" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_right_moving_3" geom1="study_cafe_cup_collision" geom2="right_moving_jaw_contact_3" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_left_fixed_1" geom1="study_cafe_lego_collision" geom2="left_fixed_jaw_contact_1" condim="6" friction="5 5 0.4 0.15 0.15" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_left_fixed_2" geom1="study_cafe_lego_collision" geom2="left_fixed_jaw_contact_2" condim="6" friction="5 5 0.4 0.15 0.15" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_left_moving_1" geom1="study_cafe_lego_collision" geom2="left_moving_jaw_contact_1" condim="6" friction="5 5 0.4 0.15 0.15" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_left_moving_2" geom1="study_cafe_lego_collision" geom2="left_moving_jaw_contact_2" condim="6" friction="5 5 0.4 0.15 0.15" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_left_moving_3" geom1="study_cafe_lego_collision" geom2="left_moving_jaw_contact_3" condim="6" friction="5 5 0.4 0.15 0.15" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_right_fixed_1" geom1="study_cafe_lego_collision" geom2="right_fixed_jaw_contact_1" condim="6" friction="5 5 0.4 0.15 0.15" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_right_fixed_2" geom1="study_cafe_lego_collision" geom2="right_fixed_jaw_contact_2" condim="6" friction="5 5 0.4 0.15 0.15" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_right_moving_1" geom1="study_cafe_lego_collision" geom2="right_moving_jaw_contact_1" condim="6" friction="5 5 0.4 0.15 0.15" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_right_moving_2" geom1="study_cafe_lego_collision" geom2="right_moving_jaw_contact_2" condim="6" friction="5 5 0.4 0.15 0.15" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_right_moving_3" geom1="study_cafe_lego_collision" geom2="right_moving_jaw_contact_3" condim="6" friction="5 5 0.4 0.15 0.15" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
  </contact>

  <equality>
    <weld name="study_cafe_grasp_chassis_world_weld" body1="chassis"
          solref="0.002 1"/>
  </equality>

</mujoco>
