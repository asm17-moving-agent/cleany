<mujoco model="cleany_study_cafe_grasp_execution">
  <!-- 카메라 구체화 계약: @CLEANY_STUDY_CAFE_HEAD_CAMERA_CONTRACT@ -->
  <include file="@CLEANY_MJCF_PATH@"/>

  <option timestep="0.001" gravity="0 0 -9.80665" integrator="implicitfast"
          solver="Newton" iterations="100" ls_iterations="20"
          noslip_iterations="20">
    <flag multiccd="enable"/>
  </option>

  <statistic center="-3.13 -3.60 0.80" extent="1.8"/>

  <visual>
    <quality offsamples="1"/>
    <headlight active="1" diffuse="0.35 0.35 0.35"
               ambient="0.30 0.30 0.30" specular="0 0 0"/>
    <rgba haze="0.82 0.83 0.84 1"/>
    <global azimuth="180" elevation="-25" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <mesh name="study_cafe_mouse_mesh"
          file="@CLEANY_STUDY_CAFE_ASSET_DIR@/study_cafe_mouse.obj"/>
    <texture type="skybox" builtin="gradient" rgb1="0.82 0.83 0.84"
             rgb2="0.55 0.57 0.60" width="512" height="3072"/>
    <texture type="2d" name="study_cafe_grasp_floor_texture"
             builtin="checker" rgb1="0.69 0.67 0.62"
             rgb2="0.62 0.60 0.55" width="512" height="512"/>
    <material name="study_cafe_grasp_floor"
              texture="study_cafe_grasp_floor_texture" texuniform="true"
              texrepeat="12 11" reflectance="0.05" specular="0.05"
              shininess="0.1"/>
  </asset>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane"
          material="study_cafe_grasp_floor" contype="1" conaffinity="1"
          condim="4" friction="1 0.005 0.0001"/>
    @CLEANY_STUDY_CAFE_ENVIRONMENT@
  </worldbody>

  <!-- 시뮬레이션 전용 그리퍼 마찰이며 종이컵과 LEGO의 복합 geom 전체에 적용합니다. -->
  <contact>
    <!-- 강체 마우스 대체 형상입니다. 원래 혼합 마찰과 강성이 높은 그리퍼 접촉을 사용합니다. -->
    <pair name="mouse_left_fixed_1" geom1="study_cafe_mouse_collision" geom2="@CLEANY_CONTACT_LEFT_FIXED_1@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="mouse_left_fixed_2" geom1="study_cafe_mouse_collision" geom2="@CLEANY_CONTACT_LEFT_FIXED_2@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="mouse_left_moving_1" geom1="study_cafe_mouse_collision" geom2="@CLEANY_CONTACT_LEFT_MOVING_1@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="mouse_left_moving_2" geom1="study_cafe_mouse_collision" geom2="@CLEANY_CONTACT_LEFT_MOVING_2@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="mouse_left_moving_3" geom1="study_cafe_mouse_collision" geom2="@CLEANY_CONTACT_LEFT_MOVING_3@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="mouse_right_fixed_1" geom1="study_cafe_mouse_collision" geom2="@CLEANY_CONTACT_RIGHT_FIXED_1@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="mouse_right_fixed_2" geom1="study_cafe_mouse_collision" geom2="@CLEANY_CONTACT_RIGHT_FIXED_2@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="mouse_right_moving_1" geom1="study_cafe_mouse_collision" geom2="@CLEANY_CONTACT_RIGHT_MOVING_1@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="mouse_right_moving_2" geom1="study_cafe_mouse_collision" geom2="@CLEANY_CONTACT_RIGHT_MOVING_2@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="mouse_right_moving_3" geom1="study_cafe_mouse_collision" geom2="@CLEANY_CONTACT_RIGHT_MOVING_3@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <!-- 강체 티슈 대체 형상입니다. 혼합 마찰을 유지하고 수치적 침투를 방지합니다. -->
    <pair name="tissue_left_fixed_1" geom1="study_cafe_tissue_collision" geom2="@CLEANY_CONTACT_LEFT_FIXED_1@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_left_fixed_2" geom1="study_cafe_tissue_collision" geom2="@CLEANY_CONTACT_LEFT_FIXED_2@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_left_moving_1" geom1="study_cafe_tissue_collision" geom2="@CLEANY_CONTACT_LEFT_MOVING_1@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_left_moving_2" geom1="study_cafe_tissue_collision" geom2="@CLEANY_CONTACT_LEFT_MOVING_2@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_left_moving_3" geom1="study_cafe_tissue_collision" geom2="@CLEANY_CONTACT_LEFT_MOVING_3@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_right_fixed_1" geom1="study_cafe_tissue_collision" geom2="@CLEANY_CONTACT_RIGHT_FIXED_1@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_right_fixed_2" geom1="study_cafe_tissue_collision" geom2="@CLEANY_CONTACT_RIGHT_FIXED_2@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_right_moving_1" geom1="study_cafe_tissue_collision" geom2="@CLEANY_CONTACT_RIGHT_MOVING_1@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_right_moving_2" geom1="study_cafe_tissue_collision" geom2="@CLEANY_CONTACT_RIGHT_MOVING_2@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="tissue_right_moving_3" geom1="study_cafe_tissue_collision" geom2="@CLEANY_CONTACT_RIGHT_MOVING_3@" condim="6" friction="3 3 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <!-- 얇은 강체 컵입니다. 높은 접촉 강성으로 그리퍼의 벽 침투를 막습니다.
변형 가능한 종이 모델이 아니며 마찰과 구동기 한계는 유지합니다. -->
    <pair name="cup_left_fixed_1" geom1="study_cafe_cup_collision" geom2="@CLEANY_CONTACT_LEFT_FIXED_1@" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_left_fixed_2" geom1="study_cafe_cup_collision" geom2="@CLEANY_CONTACT_LEFT_FIXED_2@" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_left_moving_1" geom1="study_cafe_cup_collision" geom2="@CLEANY_CONTACT_LEFT_MOVING_1@" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_left_moving_2" geom1="study_cafe_cup_collision" geom2="@CLEANY_CONTACT_LEFT_MOVING_2@" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_left_moving_3" geom1="study_cafe_cup_collision" geom2="@CLEANY_CONTACT_LEFT_MOVING_3@" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_right_fixed_1" geom1="study_cafe_cup_collision" geom2="@CLEANY_CONTACT_RIGHT_FIXED_1@" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_right_fixed_2" geom1="study_cafe_cup_collision" geom2="@CLEANY_CONTACT_RIGHT_FIXED_2@" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_right_moving_1" geom1="study_cafe_cup_collision" geom2="@CLEANY_CONTACT_RIGHT_MOVING_1@" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_right_moving_2" geom1="study_cafe_cup_collision" geom2="@CLEANY_CONTACT_RIGHT_MOVING_2@" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="cup_right_moving_3" geom1="study_cafe_cup_collision" geom2="@CLEANY_CONTACT_RIGHT_MOVING_3@" condim="6" friction="6 6 0.2 0.1 0.1" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <!-- LEGO는 미끄럼 마찰 파지를 유지하되 과도한 비틀림 및 구름 접촉 저항을 피합니다.
파지와 놓기 동안 동일하며 접촉 비활성화나 인위적 낙하 힘을 사용하지 않습니다. -->
    <pair name="lego_left_fixed_1" geom1="study_cafe_lego_collision" geom2="@CLEANY_CONTACT_LEFT_FIXED_1@" condim="6" friction="1.5 1.5 0.001 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_left_fixed_2" geom1="study_cafe_lego_collision" geom2="@CLEANY_CONTACT_LEFT_FIXED_2@" condim="6" friction="1.5 1.5 0.001 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_left_moving_1" geom1="study_cafe_lego_collision" geom2="@CLEANY_CONTACT_LEFT_MOVING_1@" condim="6" friction="1.5 1.5 0.001 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_left_moving_2" geom1="study_cafe_lego_collision" geom2="@CLEANY_CONTACT_LEFT_MOVING_2@" condim="6" friction="1.5 1.5 0.001 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_left_moving_3" geom1="study_cafe_lego_collision" geom2="@CLEANY_CONTACT_LEFT_MOVING_3@" condim="6" friction="1.5 1.5 0.001 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_right_fixed_1" geom1="study_cafe_lego_collision" geom2="@CLEANY_CONTACT_RIGHT_FIXED_1@" condim="6" friction="1.5 1.5 0.001 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_right_fixed_2" geom1="study_cafe_lego_collision" geom2="@CLEANY_CONTACT_RIGHT_FIXED_2@" condim="6" friction="1.5 1.5 0.001 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_right_moving_1" geom1="study_cafe_lego_collision" geom2="@CLEANY_CONTACT_RIGHT_MOVING_1@" condim="6" friction="1.5 1.5 0.001 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_right_moving_2" geom1="study_cafe_lego_collision" geom2="@CLEANY_CONTACT_RIGHT_MOVING_2@" condim="6" friction="1.5 1.5 0.001 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
    <pair name="lego_right_moving_3" geom1="study_cafe_lego_collision" geom2="@CLEANY_CONTACT_RIGHT_MOVING_3@" condim="6" friction="1.5 1.5 0.001 0.0001 0.0001" solref="0.002 1" solimp="0.99 0.9999 0.0001"/>
  </contact>

  <equality>
    <weld name="study_cafe_grasp_chassis_world_weld" body1="chassis"
          solref="0.002 1"/>
  </equality>

</mujoco>
