Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Map
      Name: Saved SLAM map
      Enabled: true
      Value: true
      Alpha: 1
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /map
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: Persistent obstacle memory
      Enabled: true
      Value: true
      Alpha: 0.65
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /obstacle_memory/grid
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: LIVE local costmap
      Enabled: true
      Value: true
      Alpha: 0.65
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /local_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
    - Class: rviz_default_plugins/Map
      Name: Global costmap (optional)
      Enabled: false
      Value: false
      Alpha: 0.45
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /global_costmap/costmap
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR observations
      Enabled: true
      Value: true
      Alpha: 1
      Color: 0; 160; 80
      Color Transformer: FlatColor
      Position Transformer: XYZ
      Style: Points
      Size (Pixels): 3
      Topic:
        Value: /scan
        Depth: 5
        Reliability Policy: Best Effort
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/Polygon
      Name: Planning footprint
      Enabled: true
      Value: true
      Alpha: 1
      Color: 0; 140; 210
      Topic:
        Value: /local_costmap/published_footprint
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/Path
      Name: Nav2 planned path
      Enabled: true
      Value: true
      Alpha: 1
      Color: 0; 150; 50
      Line Style: Lines
      Line Width: 0.04
      Topic:
        Value: /plan
        Depth: 5
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: Live demo labels
      Enabled: true
      Value: true
      Topic:
        Value: /evaluation/live_labels
        Depth: 1
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
  Enabled: true
  Global Options:
    Background Color: 220; 224; 229
    Fixed Frame: map
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Target Frame: <Fixed Frame>
      Scale: 120
      Angle: 0
      X: 2
      Y: 0
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Entire SLAM map
        Target Frame: <Fixed Frame>
        Scale: 65
        Angle: 0
        X: 4.7
        Y: -1.9
Window Geometry:
  Height: 1000
  Width: 1500
  Hide Right Dock: true
