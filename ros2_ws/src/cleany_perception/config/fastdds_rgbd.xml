<?xml version="1.0" encoding="UTF-8"?>
<!-- ROS 2 Humble / Fast DDS 2.6: same-host RGB-D and PointCloud2 samples.
     Per-participant bounded 16 MiB SHM, plus UDP for remote participants.
     This does not change endpoint QoS or freshness/geometry acceptance gates. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>cleany_rgbd_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>cleany_rgbd_shm</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="cleany_rgbd" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>cleany_rgbd_udp</transport_id>
        <transport_id>cleany_rgbd_shm</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
