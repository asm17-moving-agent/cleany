<?xml version="1.0" encoding="UTF-8"?>
<!-- ROS 2 Humble / Fast DDS 2.6의 같은 호스트 RGB-D 및 PointCloud2 표본용입니다.
participant별 SHM을 16MiB로 제한하고 원격 participant에는 UDP를 사용합니다.
endpoint QoS나 최신성 및 기하 수락 조건은 바꾸지 않습니다. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>cleany_rgbd_udp</transport_id>
      <type>UDPv4</type>
      <receiveBufferSize>8388608</receiveBufferSize>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>cleany_rgbd_shm</transport_id>
      <type>SHM</type>
      <segment_size>16777216</segment_size>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="cleany_rgbd" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>cleany_rgbd_udp</transport_id>
        <transport_id>cleany_rgbd_shm</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
