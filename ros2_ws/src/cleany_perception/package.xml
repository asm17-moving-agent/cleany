<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cleany_perception</name>
  <version>0.1.0</version>
  <description>One-shot RGB-D object inspection for Cleany.</description>
  <maintainer email="team@example.com">Cleany Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>cleany_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>google-genai</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>action_msgs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
