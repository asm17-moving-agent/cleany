<?xml version="1.0" encoding="UTF-8"?>
<!-- Keep time-critical control feedback off the RGB-D shared-memory transport. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>cleany_control_udp</transport_id>
      <type>UDPv4</type>
      <receiveBufferSize>8388608</receiveBufferSize>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="cleany_control_udp" is_default_profile="true">
    <rtps>
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports><transport_id>cleany_control_udp</transport_id></userTransports>
    </rtps>
  </participant>
</profiles>
