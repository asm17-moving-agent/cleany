<?xml version="1.0"?>
<package format="3">
  <name>cleany_system_supervisor</name>
  <version>0.1.0</version>
  <description>Capability-based system availability and recovery coordination.</description>
  <maintainer email="team@example.com">Cleany Team</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cleany_interfaces</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- supervision.launch.py; cleany_navigation and cleany_skill_executor provide the
       optional lifecycle recovery owner and arm reporter and are resolved only when enabled. -->
  <exec_depend>cleany_safety_adapter</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>cleany_mission_manager</test_depend>
  <test_depend>cleany_base_driver</test_depend>
  <test_depend>nav2_msgs</test_depend>
  <test_depend>nav_msgs</test_depend>
  <test_depend>std_srvs</test_depend>
  <test_depend>tf2_ros</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
