#!/usr/bin/env bash
# Source to locate the native overlay using the same defaults as the Makefile.
cleany_install_repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cleany_install_data="${CLEANY_DATA_ROOT:-${cleany_install_repo}/../cleany-data}"
if [[ -f "${cleany_install_repo}/.env.workspace-build" ]]; then
  cleany_install_build="${cleany_install_repo}/ros2_ws"
else
  cleany_install_build="${cleany_install_data}/builds/$(basename "${cleany_install_repo}")"
fi
export CLEANY_BUILD_ROOT="${CLEANY_BUILD_ROOT:-${cleany_install_build}}"
export CLEANY_INSTALL_BASE="${CLEANY_INSTALL_BASE:-${CLEANY_BUILD_ROOT}/install}"
unset cleany_install_repo cleany_install_data cleany_install_build
